{
  "version": 2,
  "tiers": {
    "deterministic_existing": "a shipped check in the science profile should block it today",
    "deterministic_new": "blockable by code once the increment carries a declaration the generator can honestly make (the science-ai4s pack)",
    "referent": "needs the constitution or task text; a model with the rule in front of it may catch it; code cannot",
    "judgement": "expert judgement; recorded so the model rung can be measured; expected deterministic recall 0"
  },
  "classes": [
    {"id": "D01", "name": "schema_missing_field", "tier": "deterministic_existing",
     "rules": ["CA-META-001"], "checks": ["schema"], "severity": "BLOCKER",
     "domains": "all",
     "variants": ["no_code_version", "no_quantities", "inputs_not_path_at_rev"]},
    {"id": "D02", "name": "unit_missing", "tier": "deterministic_existing",
     "rules": ["CA-DATA-001"], "checks": ["units"], "severity": "BLOCKER",
     "domains": "all",
     "variants": ["empty_unit", "empty_source"]},
    {"id": "D03", "name": "unit_wrong", "tier": "deterministic_new",
     "rules": ["CA-PHYS-001"], "checks": ["range_rules"], "severity": "BLOCKER",
     "domains": "all",
     "variants": ["label_swapped"]},
    {"id": "D04", "name": "provenance_broken", "tier": "deterministic_existing",
     "rules": ["CA-DATA-003"], "checks": ["provenance"], "severity": "BLOCKER",
     "domains": "all",
     "variants": ["source_not_declared", "input_file_missing", "revision_mismatch"],
     "variant_overrides": {"revision_mismatch": {"severity": "ADVISORY"}},
     "notes": "revision_mismatch is ADVISORY in the shipped check (a matching source whose revision differs from code_version); it is scored as caught when the CA-DATA-003 advisory fires"},
    {"id": "D05", "name": "unconverged_reported", "tier": "deterministic_existing",
     "rules": ["CA-METH-002"], "checks": ["convergence"], "severity": "BLOCKER",
     "domains": ["dft_convergence"],
     "variants": ["converged_false", "achieved_over_threshold"]},
    {"id": "D06", "name": "prose_data_mismatch", "tier": "mixed",
     "rules": ["CA-NUM-002", "CA-DATA-002"], "checks": ["number_source"], "severity": "BLOCKER",
     "domains": "all",
     "variants": ["annotated_digit_swap", "unannotated_digit_swap", "sign_word_flip"],
     "variant_tiers": {"annotated_digit_swap": "deterministic_existing",
                       "unannotated_digit_swap": "referent",
                       "sign_word_flip": "referent"}},
    {"id": "D07", "name": "sign_flip", "tier": "deterministic_new",
     "rules": ["CA-PHYS-001"], "checks": ["range_rules"], "severity": "BLOCKER",
     "domains": ["arrhenius_kinetics", "crystal_bandgap_ml", "biostat_two_group"],
     "variants": ["value_negated"]},
    {"id": "D08", "name": "physical_range_violation", "tier": "deterministic_new",
     "rules": ["CA-PHYS-001"], "checks": ["range_rules"], "severity": "BLOCKER",
     "domains": "all",
     "variants": ["above_max", "below_min"]},
    {"id": "D09", "name": "numeric_invalid", "tier": "deterministic_new",
     "rules": ["CA-NUM-005"], "checks": ["numeric_validity"], "severity": "BLOCKER",
     "domains": "all",
     "variants": ["nan", "inf", "null", "string_value"]},
    {"id": "D10", "name": "derivation_mismatch", "tier": "deterministic_new",
     "rules": ["CA-DERIV-001"], "checks": ["derivations"], "severity": "BLOCKER",
     "domains": "all",
     "variants": ["value_perturbed_1pct", "value_perturbed_10pct", "wrong_rows_used"],
     "notes": "wrong_rows_used applies to domains with a split (crystal_bandgap_ml) and to biostat (control rows reported as treated)"},
    {"id": "D11", "name": "n_mismatch", "tier": "deterministic_new",
     "rules": ["CA-DERIV-001"], "checks": ["derivations"], "severity": "BLOCKER",
     "domains": "all",
     "variants": ["n_inflated", "n_deflated"]},
    {"id": "D12", "name": "split_leakage", "tier": "deterministic_new",
     "rules": ["CA-ML-001"], "checks": ["split_integrity"], "severity": "BLOCKER",
     "domains": ["crystal_bandgap_ml"],
     "variants": ["id_overlap", "group_overlap", "test_id_not_in_data", "duplicate_test_id"]},
    {"id": "D13", "name": "claim_false", "tier": "deterministic_new",
     "rules": ["CA-STAT-004"], "checks": ["claims"], "severity": "BLOCKER",
     "domains": ["biostat_two_group", "crystal_bandgap_ml", "nmr_shift_calibration"],
     "variants": ["significance_overclaim", "ci_claim_false", "improvement_claim_false"]},
    {"id": "D14", "name": "method_claim_mismatch", "tier": "judgement",
     "rules": ["CA-DATA-002"], "checks": [], "severity": "BLOCKER",
     "domains": "all",
     "variants": ["prose_method_differs"]},
    {"id": "D15", "name": "placeholder_or_truncated", "tier": "mixed",
     "rules": ["CA-NUM-001"], "checks": ["number_source"], "severity": "BLOCKER",
     "domains": "all",
     "variants": ["todo_left", "template_placeholder", "summary_truncated_mid_block"],
     "variant_overrides": {
       "todo_left": {"tier": "deterministic_new", "rules": ["CA-FILE-004"], "checks": ["complete"], "severity": "ADVISORY"},
       "template_placeholder": {"tier": "deterministic_new", "rules": ["CA-FILE-004"], "checks": ["complete"], "severity": "ADVISORY"},
       "summary_truncated_mid_block": {"tier": "deterministic_existing"}},
     "variant_tiers": {"todo_left": "deterministic_new",
                       "template_placeholder": "deterministic_new",
                       "summary_truncated_mid_block": "deterministic_existing"},
     "notes": "The shipped `complete` check (general pack) reports a leftover placeholder as CA-FILE-004 at ADVISORY, never CA-CONTENT-001; `complete-strict` would block but also blocks every <CAPS> token, which science prose uses for crystallographic directions, so science-ai4s carries the advisory form. todo_left and template_placeholder are therefore expected to be MISSED by `science` (no `complete` at all) and to raise the CA-FILE-004 advisory under science-ai4s. summary_truncated_mid_block is caught by number_source's unclosed-fence rule (CA-NUM-001, BLOCKER) in both profiles."},
    {"id": "D16", "name": "reproducibility_missing", "tier": "deterministic_new",
     "rules": ["CA-REPRO-001"], "checks": ["repro_declared"], "severity": "ADVISORY",
     "domains": "all",
     "variants": ["no_seed", "no_command", "no_environment"]},
    {"id": "D17", "name": "precision_overclaim", "tier": "deterministic_new",
     "rules": ["CA-PREC-001"], "checks": ["precision"], "severity": "ADVISORY",
     "domains": "all",
     "variants": ["digits_beyond_uncertainty"]},
    {"id": "D18", "name": "aggregate_mismatch", "tier": "deterministic_new",
     "rules": ["CA-DERIV-001"], "checks": ["derivations"], "severity": "BLOCKER",
     "domains": ["crystal_bandgap_ml", "biostat_two_group", "xrd_bragg"],
     "variants": ["ratio_inverted", "percent_sign_flipped", "sd_population_as_sd",
                  "sd_as_sd_population", "median_perturbed_1pct"],
     "added": "v2, DESIGN.md section 9 Amendment 3 (2026-10-22); not part of the preregistration",
     "notes": "An aggregate the v2 pack can recompute, reported wrong in the way the first dogfood audit found real reports get it wrong: a ratio written the wrong way up, a percent change with the wrong sign, numpy's population sd (ddof=0) reported where the declaration says sample sd and the reverse, a median off by 1%. A class of its own rather than more D10 variants, so the preregistered D10 figure stays comparable across the two runs. Narrowed per variant by each domain's SPEC['d18']."}
  ],
  "domains": ["crystal_bandgap_ml", "nmr_shift_calibration", "arrhenius_kinetics",
              "dft_convergence", "xrd_bragg", "biostat_two_group"],
  "seeds_per_domain": 10,
  "generation_seed": 20261021
}
